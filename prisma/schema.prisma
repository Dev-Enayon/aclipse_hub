generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  role          String    @default("VISITOR") // VISITOR, STUDENT, ADMIN, SUPER_ADMIN
  provider      String    @default("google") // authentication provider
  passwordHash  String? // scrypt "salt:hash" — set only for credentials-based accounts (e.g. admin)
  emailVerified DateTime?
  lastLoginAt   DateTime?
  lastActiveAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  student       Student?
  admin         Admin?
  attempts      StudentAttempt[]
  quizAttempts  QuizAttempt[]
  auditLogs     AuditLog[]
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String // ALOC subject slug (e.g. "chemistry")
  examType  String // utme | wassce | post-utme | "" for mixed
  total     Int // number of questions in the quiz
  score     Int // number answered correctly
  createdAt DateTime @default(now())

  @@map("quiz_attempts")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Student {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrolledAt  DateTime  @default(now())
  status      String    @default("PENDING") // PENDING, APPROVED, SUSPENDED
  accountStatus String  @default("ACTIVE") // ACTIVE, DEACTIVATED
  phone       String?
  institution String?

  profileCompleted   Boolean @default(false)
  profileCompletion  Int     @default(0) // percentage 0-100

  surname         String?
  otherNames      String?
  preferredName   String?
  gender          String? // MALE, FEMALE, PREFER_NOT_TO_SAY
  dateOfBirth     DateTime?
  stateOfOrigin   String?
  lga             String?
  homeAddress     String?

  schoolLevel        String? // JUNIOR_SECONDARY, SENIOR_SECONDARY
  classLevel         String? // JSS1..JSS3, SS1..SS3, JAMBITE
  department         String? // SCIENCE, HUMANITIES, COMMERCIAL
  schoolName         String?
  schoolType         String? // PUBLIC, PRIVATE, OTHER
  academicSession    String?
  previousClass      String?
  academicPerformance String? // EXCELLENT, VERY_GOOD, GOOD, AVERAGE, NEEDS_IMPROVEMENT
  favouriteSubject   String?
  difficultSubjects  String  @default("[]") // JSON string array

  jambRegNumber        String?
  jambTargetScore      Int?
  intendedCourseOfStudy String?
  firstChoiceUniversity String?
  secondChoiceUniversity String?
  utmeSubjects         String  @default("[]") // JSON string array
  mockScore            Int?

  guardianName           String?
  guardianRelationship   String? // FATHER, MOTHER, GUARDIAN, OTHER
  guardianPhone          String?
  guardianEmail          String?
  emergencyContactName   String?
  emergencyContactPhone  String?

  aboutMe        String?
  hobbies        String  @default("[]") // JSON string array
  interests      String  @default("[]") // JSON string array
  careerAmbition String?
  dreamJob       String?

  attempts    StudentAttempt[]

  @@map("students")
}

model Admin {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions String   @default("[]") // JSON array of permissions

  @@map("admins")
}

model Subject {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topics      Topic[]
  questions   Question[]
  exams       Exam[]
  weeklyQuizzes WeeklyQuiz[]

  @@map("subjects")
}

model Topic {
  id          String   @id @default(cuid())
  name        String
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  questions   Question[]

  @@map("topics")
}

model Question {
  id              String    @id @default(cuid())
  text            String
  options         String    @default("[]") // JSON array of 4 options
  correctAnswer   Int       @default(0) // Index of correct option (0-3)
  explanation     String?
  subjectId       String
  subject         Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topicId         String?
  topic           Topic?    @relation(fields: [topicId], references: [id], onDelete: SetNull)
  difficulty      String    @default("MEDIUM") // EASY, MEDIUM, HARD
  tags            String    @default("[]") // JSON array of tags
  year            Int?
  imageUrl        String?
  status          String    @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  examQuestions   ExamQuestion[]
  weeklyQuizQuestions WeeklyQuizQuestion[]

  @@map("questions")
}

model Exam {
  id            String   @id @default(cuid())
  title         String
  description   String?
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  timer         Int      @default(60) // minutes
  passingScore  Int      @default(50) // percentage
  status        String   @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  questions     ExamQuestion[]
  attempts      StudentAttempt[]

  @@map("exams")
}

model ExamQuestion {
  id          String   @id @default(cuid())
  examId      String
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order       Int

  @@unique([examId, questionId])
  @@map("exam_questions")
}

model WeeklyQuiz {
  id            String   @id @default(cuid())
  title         String
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  scheduledAt   DateTime?
  status        String   @default("DRAFT") // DRAFT, SCHEDULED, PUBLISHED, ARCHIVED
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  questions     WeeklyQuizQuestion[]
  attempts      StudentAttempt[]

  @@map("weekly_quizzes")
}

model WeeklyQuizQuestion {
  id          String   @id @default(cuid())
  quizId      String
  quiz        WeeklyQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order       Int

  @@unique([quizId, questionId])
  @@map("weekly_quiz_questions")
}

model StudentAttempt {
  id            String    @id @default(cuid())
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  examId        String?
  exam          Exam?     @relation(fields: [examId], references: [id], onDelete: SetNull)
  quizId        String?
  quiz          WeeklyQuiz? @relation(fields: [quizId], references: [id], onDelete: SetNull)
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  score         Int?
  totalQuestions Int?
  answers       String    @default("[]") // JSON array of selected answers
  timeTaken     Int?      // seconds

  results       Result[]

  @@map("student_attempts")
}

model Result {
  id              String   @id @default(cuid())
  attemptId       String
  attempt         StudentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  totalQuestions  Int
  correctAnswers  Int
  percentage      Float
  subjectBreakdown String   @default("{}") // JSON performance by subject/topic
  createdAt       DateTime @default(now())

  @@map("results")
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  authorId  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("announcements")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String   @default("{}") // JSON details
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

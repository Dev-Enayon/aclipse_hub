generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  role          String    @default("VISITOR") // VISITOR, STUDENT, ADMIN, SUB_ADMIN, SUPER_ADMIN
  provider      String    @default("google") // authentication provider
  passwordHash  String? // scrypt "salt:hash" — set only for credentials-based accounts (e.g. admin)
  emailVerified DateTime?
  lastLoginAt   DateTime?
  lastActiveAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  student       Student?
  admin         Admin?
  attempts      StudentAttempt[]
  quizAttempts  QuizAttempt[]
  activities    Activity[]
  questions     Question[]     @relation("QuestionAuthor")
  reviewedQuestions Question[] @relation("QuestionReviewer")
  exams         Exam[]         @relation("ExamAuthor")
  reviewedExams Exam[]         @relation("ExamReviewer")
  weeklyQuizzes WeeklyQuiz[]   @relation("QuizAuthor")
  adminActivityLogs AdminActivityLog[]
  auditLogs     AuditLog[]
  accounts      Account[]
  sessions      Session[]
  passwordResetTokens PasswordResetToken[]
  entryCodes    EntryCode[] @relation("EntryCodeCreator")
  notifications Notification[]

  @@map("users")
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // quiz_started, quiz_completed, profile_completed, login
  subject   String?  // subject slug if relevant
  details   String   @default("{}") // JSON metadata (score, examType, etc.)
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@map("activities")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique // SHA-256 of the plaintext token emailed to the user
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String // ALOC subject slug (e.g. "chemistry")
  examType  String // utme | wassce | post-utme | "" for mixed
  total     Int // number of questions in the quiz
  score     Int // number answered correctly
  createdAt DateTime @default(now())

  @@map("quiz_attempts")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Student {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrolledAt  DateTime  @default(now())
  status      String    @default("PENDING") // PENDING, APPROVED, SUSPENDED
  accountStatus String  @default("ACTIVE") // ACTIVE, DEACTIVATED
  phone       String?
  institution String?

  profileCompleted   Boolean @default(false)
  profileCompletion  Int     @default(0) // percentage 0-100

  surname         String?
  otherNames      String?
  preferredName   String?
  gender          String? // MALE, FEMALE, PREFER_NOT_TO_SAY
  dateOfBirth     DateTime?
  stateOfOrigin   String?
  lga             String?
  homeAddress     String?

  schoolLevel        String? // JUNIOR_SECONDARY, SENIOR_SECONDARY
  classLevel         String? // JSS1..JSS3, SS1..SS3, JAMBITE
  department         String? // SCIENCE, HUMANITIES, COMMERCIAL
  schoolName         String?
  schoolType         String? // PUBLIC, PRIVATE, OTHER
  academicSession    String?
  previousClass      String?
  academicPerformance String? // EXCELLENT, VERY_GOOD, GOOD, AVERAGE, NEEDS_IMPROVEMENT
  favouriteSubject   String?
  difficultSubjects  String  @default("[]") // JSON string array

  jambRegNumber        String?
  jambTargetScore      Int?
  intendedCourseOfStudy String?
  firstChoiceUniversity String?
  secondChoiceUniversity String?
  utmeSubjects         String  @default("[]") // JSON string array
  mockScore            Int?

  guardianName           String?
  guardianRelationship   String? // FATHER, MOTHER, GUARDIAN, OTHER
  guardianPhone          String?
  guardianEmail          String?
  emergencyContactName   String?
  emergencyContactPhone  String?

  aboutMe        String?
  hobbies        String  @default("[]") // JSON string array
  interests      String  @default("[]") // JSON string array
  careerAmbition String?
  dreamJob       String?

  attempts    StudentAttempt[]

  @@map("students")
}

model Admin {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions String   @default("[]") // JSON array of permissions
  department  String?  // department or focus area
  status      String   @default("ACTIVE") // ACTIVE, SUSPENDED

  @@map("admins")
}

model Subject {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topics      Topic[]
  questions   Question[]
  exams       Exam[]
  weeklyQuizzes WeeklyQuiz[]

  @@map("subjects")
}

model Topic {
  id          String   @id @default(cuid())
  name        String
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  questions   Question[]

  @@map("topics")
}

model Question {
  id              String    @id @default(cuid())
  text            String
  options         String    @default("[]") // JSON array of options
  correctAnswer   Int       @default(0) // Index of correct option (0-based)
  explanation     String?
  subjectId       String
  subject         Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topicId         String?
  topic           Topic?    @relation(fields: [topicId], references: [id], onDelete: SetNull)
  difficulty      String    @default("MEDIUM") // EASY, MEDIUM, HARD
  questionType    String    @default("MCQ") // MCQ, TRUE_FALSE, OBJECTIVE
  schoolTier      String?   // JSS1..JSS3, SS1..SS3 (null = general study)
  examType        String    @default("CBT") // CBT, JAMB
  marks           Int       @default(1) // marks/score for this question
  tags            String    @default("[]") // JSON array of tags
  year            Int?
  imageUrl        String?
  status          String    @default("DRAFT") // DRAFT, PENDING_REVIEW, APPROVED, REJECTED, PUBLISHED, ARCHIVED
  createdBy       String?
  author          User?     @relation("QuestionAuthor", fields: [createdBy], references: [id], onDelete: SetNull)
  reviewedBy      String?
  reviewer        User?     @relation("QuestionReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  reviewFeedback  String? // set when REJECTED — feedback for the Sub-Admin author
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  examQuestions   ExamQuestion[]
  weeklyQuizQuestions WeeklyQuizQuestion[]

  @@map("questions")
}

model Exam {
  id            String   @id @default(cuid())
  title         String
  description   String?
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  schoolTier    String? // JSS1..JSS3, SS1..SS3 (null = general)
  examType      String   @default("CBT") // CBT, JAMB
  timer         Int      @default(60) // minutes
  passingScore  Int      @default(50) // percentage
  totalMarks    Int      @default(60) // total marks for the exam
  status        String   @default("DRAFT") // DRAFT, PENDING_REVIEW, APPROVED, REJECTED, PUBLISHED, ARCHIVED
  reviewFeedback String? // set when REJECTED — feedback for the creating Sub-Admin
  reviewedBy    String?
  reviewer      User?    @relation("ExamReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  createdBy     String?
  author        User?    @relation("ExamAuthor", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  questions     ExamQuestion[]
  attempts      StudentAttempt[]
  entryCodes    EntryCode[]

  @@map("exams")
}

model ExamQuestion {
  id          String   @id @default(cuid())
  examId      String
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order       Int

  @@unique([examId, questionId])
  @@map("exam_questions")
}

model WeeklyQuiz {
  id            String   @id @default(cuid())
  title         String
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  scheduledAt   DateTime?
  status        String   @default("DRAFT") // DRAFT, SCHEDULED, PUBLISHED, ARCHIVED
  createdBy     String?
  author        User?    @relation("QuizAuthor", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  questions     WeeklyQuizQuestion[]
  attempts      StudentAttempt[]

  @@map("weekly_quizzes")
}

model WeeklyQuizQuestion {
  id          String   @id @default(cuid())
  quizId      String
  quiz        WeeklyQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order       Int

  @@unique([quizId, questionId])
  @@map("weekly_quiz_questions")
}

model StudentAttempt {
  id            String      @id @default(cuid())
  studentId     String?
  student       Student?    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryCodeId   String?
  entryCode     EntryCode?  @relation(fields: [entryCodeId], references: [id], onDelete: SetNull)
  studentName   String? // candidate name entered with an entry code
  examId        String?
  exam          Exam?       @relation(fields: [examId], references: [id], onDelete: SetNull)
  quizId        String?
  quiz          WeeklyQuiz? @relation(fields: [quizId], references: [id], onDelete: SetNull)
  startedAt     DateTime    @default(now())
  completedAt   DateTime?
  score         Int?
  totalQuestions Int?
  answers       String      @default("[]") // JSON array of selected answer indices
  timeTaken     Int?        // seconds
  status        String      @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED

  results       Result[]

  @@map("student_attempts")
}

model Result {
  id              String   @id @default(cuid())
  attemptId       String
  attempt         StudentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  totalQuestions  Int
  correctAnswers  Int
  percentage      Float
  subjectBreakdown String   @default("{}") // JSON performance by subject/topic
  releasedAt      DateTime? // when the Head Admin released this result
  releaseToken    String?   @unique // secret lookup token for the student's result link
  createdAt       DateTime @default(now())

  @@map("results")
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  authorId  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("announcements")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String   @default("{}") // JSON details
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model AdminActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // login, logout, question_created, question_edited, question_deleted, question_published, exam_created, exam_edited, student_viewed, student_assigned, student_unassigned, etc.
  targetType String?  // question, exam, student, system
  targetId  String?  // ID of the affected resource
  details   String   @default("{}") // JSON details (name, email, etc.)
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("admin_activity_logs")
}

// Infrastructure: single-row advisory lock used by the atomic Sub-Admin
// limit functions (create_sub_admin_atomically / set_sub_admin_status_atomically).
// Declared so Prisma never tries to destroy it during migration diffs.
model SubAdminLock {
  id Int @id

  @@map("_sub_admin_lock")
}

model EntryCode {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. AHC-XXXX-XXXX
  cbtId       String?  // optional: bind the code to one specific CBT
  cbt         Exam?    @relation(fields: [cbtId], references: [id], onDelete: SetNull)
  studentName String?  // optional fixed name carried by the code
  status      String   @default("UNUSED") // UNUSED, USED, REVOKED
  usedBy      String?  // candidate name entered when the code was consumed
  usedAt      DateTime?
  createdBy   String
  creator     User     @relation("EntryCodeCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attempts    StudentAttempt[]

  @@index([cbtId])
  @@index([status])
  @@map("entry_codes")
}

model Notification {
  id              String    @id @default(cuid())
  recipientUserId String?   // null => broadcast to a whole role
  recipientRole   String    // STUDENT, SUB_ADMIN, SUPER_ADMIN, ADMIN, ALL_ADMINS
  kind            String    // MESSAGE, RESULT_RELEASE, QUESTION_STATUS, SYSTEM
  subject         String
  body            String
  link            String?   // relative in-app destination
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  recipientUser   User?     @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, readAt(sort: Desc)])
  @@index([recipientRole, createdAt(sort: Desc)])
  @@map("notifications")
}
